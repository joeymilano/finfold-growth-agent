# /etc/systemd/system/finfold-scheduler.service
# Finfold 国内站调度守护进程：生成任务执行 + 定时任务（对应 Cloudflare
# Worker 的 Queue 消费者与 Cron Triggers）。安装方式见 docs/deploy-cn.md。
[Unit]
Description=Finfold CN scheduler daemon (generation queue + crons)
After=network-online.target finfold-web.service
Wants=network-online.target

[Service]
Type=simple
User=finfold
Group=finfold
WorkingDirectory=/opt/finfold/current
EnvironmentFile=/opt/finfold/shared/.env.cn
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node scripts/cn/scheduler.mjs
Restart=always
RestartSec=10
# 停机等待进行中的生成任务收尾（scheduler 自身 90s 内退出）。
TimeoutStopSec=100
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
